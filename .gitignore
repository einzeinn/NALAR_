# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/

# ── Environment & Secrets (JANGAN PERNAH COMMIT!) ────────────────────────────
.env
.env.local
.env.*.local
backend/.env

# ── Temporary uploads ─────────────────────────────────────────────────────────
