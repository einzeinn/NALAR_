# ────────────────────────────────────────────────────────────────────────────────
# NalarAI Backend Environment Variables (FastAPI)
# ────────────────────────────────────────────────────────────────────────────────
# Copy this file to .env (already present in local) and fill in the appropriate values

# Gemini API Keys (you need 3 keys for fallback/load distribution)
# Get keys from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY_1=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_API_KEY_3=your_gemini_api_key_3_here

# CORS Allowed Origins (comma-separated, no spaces)
# Development: http://localhost:3000,http://127.0.0.1:3000
# Production: https://your-app.vercel.app
# Example: http://localhost:3000,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
